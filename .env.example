# Local development defaults; copy to .env only when customization is needed.
DATABASE_URL=sqlite:///runtime/contestly.db
APP_ENV=development
AUTO_INIT_DB=true
SEED_SNAPSHOT=true
SESSION_HOURS=24

# Production Compose: use a real domain and a generated hexadecimal password.
# Generate a password: py -3 -c "import secrets; print(secrets.token_hex(32))"
DOMAIN=example.com
POSTGRES_PASSWORD=replace-with-generated-hex-password
